<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Under the hardened runtime, Apple Events sent by this app or by the
       processes it is responsible for (osascript run by a session) are
       refused without this. The launcher runs no JIT code, so it needs no
       other entitlement. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
