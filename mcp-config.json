{
  "mcpServers": {
    "ask-user": {
      "command": "node",
      "args": ["./ask-user.js"],
      "env": {
        "BRIDGE_API_URL": "http://127.0.0.1:9812"
      }
    }
  },
  "mcpExtras": {
    "share": {
      "show-file": {
        "command": "node",
        "args": ["./show-file-mcp.js"]
      }
    },
    "browser": {
      "chrome-devtools": {
        "command": "./hooks/xvfb-wrap.sh",
        "args": ["node", "./node_modules/chrome-devtools-mcp/build/src/bin/chrome-devtools-mcp.js", "--no-usage-statistics", "--acceptInsecureCerts", "--chromeArg=--no-sandbox", "--chromeArg=--disable-setuid-sandbox", "--viewport=1920x1080"]
      }
    }
  }
}
