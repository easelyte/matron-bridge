{
  "name": "matron-bridge",
  "version": "1.0.0",
  "description": "Bridge Claude Code and Codex CLI sessions to a matron-journal server",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "setup": "node setup/wizard.mjs",
    "pair": "node setup/pair.mjs",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0",
    "check": "node scripts/check-syntax.mjs",
    "audit:high": "npm audit --audit-level=high",
    "ci": "npm run lint && npm run check && npm test && npm run audit:high"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "chrome-devtools-mcp": "1.12.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "https-proxy-agent": "^9.1.0",
    "node-pty": "^1.0.0",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.5",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "vitest": "^5.0.1"
  },
  "license": "AGPL-3.0-only",
  "overrides": {
    "form-data": "^2.5.6",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.4",
    "sanitize-html": "^2.17.4",
    "fast-uri": "^3.1.7",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.4.0",
    "postcss": "^8.5.26",
    "hono": "^4.12.34",
    "@hono/node-server": "^2.0.5"
  }
}
