# Security — the bridge's authorized user identity (sender label used for
# journal-originated session commands, and the access allowlist). Format is
# still a `@user:server`-style id. Leave empty to allow any user.
ALLOWED_USER_IDS=

# Coding-agent defaults. Only the CLI selected for a conversation must be
# installed and authenticated.
DEFAULT_WORKDIR=~/
# claude or codex. Can be overridden per command with --claude / --codex.
MATRON_DEFAULT_AGENT=claude
# Claude model for fresh starts when nothing was picked (New Chat picker,
# /start without --model): an alias (fable, opus, sonnet, haiku, ...) or a
# full claude-* name. Empty means fable. Claude only.
MATRON_DEFAULT_MODEL=
# Ops page (ops_snapshot RPC, docs/agent-rpc.md). Command for the timers /
# alerts / usage / posture sections, split on whitespace (no shell, no quoting;
# paths with spaces are unsupported); the bridge appends `--section <name>`.
# Empty = those sections answer not_configured (the host section still works).
# Example: python3 /path/to/son-of-anton/scripts/ops/ops_snapshot.py
MATRON_OPS_SNAPSHOT_CMD=
# Working directory for that command. Empty = DEFAULT_WORKDIR.
MATRON_OPS_SNAPSHOT_CWD=
SESSION_IDLE_TIMEOUT_MS=3600000
SESSION_IDLE_CHECK_MS=300000
# Bash-tool timeout floor for bridge-spawned Claude Code sessions. Claude Code's
# built-in default is 120000 (2 min), which SIGTERMs long Codex reviews / test
# suites mid-run. The bridge raises the floor to the values below. Both accept a
# positive integer of milliseconds; an out-of-range value (>3600000 = 1h) is
# clamped, a malformed value is ignored (raised default used). Takes effect at
# session spawn, so a restart is required for a change to apply.
BASH_DEFAULT_TIMEOUT_MS=1200000
BASH_MAX_TIMEOUT_MS=1800000
BRIDGE_CLAUDE_MD_PATH=
# Codex native app-server mode. Empty uses BRIDGE_CODEX.md in
# this repository. The CLI still loads its normal user/project configuration.
BRIDGE_CODEX_MD_PATH=
# Persistent stdio app-server (default), or exec for a legacy rollback.
# Exec cannot display native approvals, questions, streams, or bridge MCPs.
MATRON_CODEX_TRANSPORT=app-server
# YOLO is the Matron default: no sandbox and no approval prompts.
# Set workspace-write or read-only to use sandboxing and native approval cards.
# Matron Plan mode always remains read-only with escalations denied.
CODEX_SANDBOX_MODE=danger-full-access
# Command network access in workspace-write mode: true or false.
# Leave empty to inherit Codex's own configuration. Enable for GitHub/gh,
# dependency downloads, and other workflows requiring outbound connections.
CODEX_NETWORK_ACCESS=

# /sleep — stop the machine the bridge runs on, on demand, after a
# confirmation button (optional; empty = /sleep is disabled and says so).
#
# Deliberately unset by default, because what "sleep" means depends entirely
# on the deployment. On an orchestrated box — a VM whose supervisor starts it
# again when a chat message targets it — `sudo systemctl poweroff` is a nap.
# On a laptop or a plain VPS with nothing watching, the SAME command means the
# box is gone and nothing, including this bridge, can bring it back. Only the
# deployer knows which of those they have, so only the deployer can enable it.
#
# The command runs via `sh -c` as the bridge's own user (so a poweroff needs
# passwordless sudo). It is read from here and never from chat input.
MATRON_SLEEP_COMMAND=
# One sentence naming how this box gets woken again, shown on the confirmation
# card — the last moment the user can change their mind is the right place to
# say how to undo it. e.g. "you message this chat". Empty falls back to a
# deliberately vague "something starts it again".
MATRON_SLEEP_WAKE_HINT=
# MCP / plugin memory (small-VPS friendly; see docs/superpowers/specs)
# Comma-separated extras applied to EVERY session on this machine (names must
# match mcpExtras keys in mcp-config.json or mcp-config.local.json), e.g. circleci
MCP_DEFAULT_EXTRAS=
# Dir that plugin MCP servers (context7, serena, …) load from. Unset = a
# bridge-owned EMPTY dir (no plugin MCPs, lean). Point at ~/.claude/plugins to
# re-enable all plugins, or a curated dir for a subset.
BRIDGE_PLUGIN_CACHE_DIR=

# Set to 0 to disable Codex summaries and use deterministic fallback titles.
SUMMARY_CODEX_ENABLED=1
# Optional model override for summaries; empty uses the Codex CLI default.
SUMMARY_CODEX_MODEL=
# Maximum duration of each summary call in milliseconds (default: 60000).
SUMMARY_CODEX_TIMEOUT_MS=60000
# Maximum number of concurrent summary calls across sessions (default: 2).
SUMMARY_CODEX_MAX_CONCURRENT=2
# Set to 0 to stop publishing the rolling digest onto the journal's
# conversations.summary column (default: 1 = publish). Independent of
# SUMMARY_CODEX_ENABLED: that one kills the model call, this one kills the
# write. With it off the server COALESCEs the omitted field, so the last
# published digest stays in place rather than being cleared. To also remove what
# was already stored, copy data/matron.db first, then scope the wipe to THIS
# bridge's device — a journal DB is shared across bridges and users, so an
# unscoped UPDATE clears rows that are not yours. Preview, then apply:
#   SELECT count(*) FROM conversations
#     WHERE summary != '' AND agent_device_id = <this bridge's device id>;
#   UPDATE conversations SET summary=''
#     WHERE agent_device_id = <this bridge's device id>;
SUMMARY_JOURNAL_PUBLISH=1
# Set to 1 (or true) to include a trimmed blurb of the digest in the
# agent_roster TOOL's output — newest 3 bullets, <=300 chars, markers stripped.
# Default 0 = that tool reports an empty summary, as it did before phase 1.
#
# Read this before relying on it. The flag gates exactly ONE caller: this
# bridge's agent_roster tool. It does NOT gate the journal. The server's
# GET /roster returns the RAW conversations.summary column to any caller with a
# valid agent token, whatever this is set to — no bridge-side trim applies to
# that response, so a peer reading the endpoint directly gets the full stored
# digest, not the 300-char blurb. Turning this off changes what our tool prints,
# and nothing else.
#
# The actual boundary is the JOURNAL TOKEN. Anything holding JOURNAL_TOKEN can
# read the column; that same token already reads entire transcripts via
# /snapshot, so the digest is strictly less information than it already grants.
# Spawned sessions inherit the bridge environment, JOURNAL_TOKEN included.
# Scoping journal credentials out of child environments is separate, unshipped
# work. Until then treat conversations.summary as readable by anything running
# under this bridge, and use SUMMARY_JOURNAL_PUBLISH=0 if it must not be stored
# at all — that is the only switch that keeps the text out of the column.
AGENT_ROSTER_SUMMARY_ENABLED=0

# Debug mode (set to 1 for verbose logging)
DEBUG=0

# File viewer (optional)
HMAC_SECRET=
VIEWER_BASE_URL=
LINK_EXPIRY_MS=900000

# Web client base URL for Files deep links (optional). When set, doc handoffs
# (send_attachment / show_file / item attachments) append an "Open in Files"
# link of the form ${WEB_BASE_URL}/journal/#files=<abs>, opening the file in the
# browsable web Files tab. Token-less — auth is the operator's existing web
# session. Unset => dormant: handoffs fall back to the plain path. Set this only
# after the matron-web deep-link build is deployed (e.g. https://bridge.easelyte.ai).
WEB_BASE_URL=

# API ports
MATRON_BRIDGE_API_PORT=9802
MATRON_VIEWER_PORT=9803

# Voice note transcription (optional — requires whisper.cpp)
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=en

# Conversation titles + rolling TOC summaries (optional). OpenAI is preferred
# when set (default model gpt-6-luna); Gemini is the fallback (default
# gemini-3-flash-preview). SUMMARY_MODEL overrides the active provider's model.
# All empty: sessions work fine, titles keep the first-message fallback and no
# summary events are published.
OPENAI_API_KEY=
GEMINI_API_KEY=
SUMMARY_MODEL=

# Journal transport (required) — the matron-journal server is the bridge's
# sole transport. The bridge exits at startup unless JOURNAL_WS_URL and an
# agent token (JOURNAL_TOKEN_FILE or JOURNAL_TOKEN) are both set. Requires a
# bridge restart to take effect.
# Media mirroring (uploaded files/images -> journal file/image events) and
# read-marker advance need no config of their own — the media HTTP endpoint
# is derived from JOURNAL_WS_URL (ws:// -> http://, wss:// -> https://, strip
# the trailing /ws) and reuses the same agent token.
# Activity indicators (typing/"running <command>…" for viewing Matron clients)
# also ride this same connection — no new vars either. Ephemeral and
# best-effort: never queued/buffered/replayed, so a bridge restart or a brief
# journal outage just means a missed indicator, not a stale one later.
# In-progress assistant-text streaming (a live overlay for viewing Matron
# clients while Claude is still typing a reply) rides this same connection too —
# same ephemeral, best-effort, viewing-scoped contract as activity; the durable
# final message is published exactly as before and carries the ref that retires
# the overlay. Only the coalescing rate below is tunable.
# Same "requires a bridge restart to take effect" as everything else here.
# Use ws://127.0.0.1 only for a same-host journal server; a remote journal
# server must use wss:// — no cleartext over the network.
JOURNAL_WS_URL=wss://127.0.0.1:9810/ws
# Optional: bridge-side stream coalescing floor in ms (at most one in-progress
# frame per conversation+message per window). Defaults to 200 (~5/s), matching
# the journal server's own fan-out coalescing — sending faster is wasted work.
# Non-positive/unparseable values fall back to the default.
JOURNAL_STREAM_INTERVAL_MS=200
# Path to a file containing the agent token (read once at boot, trimmed).
# Takes precedence over JOURNAL_TOKEN if both are set.
JOURNAL_TOKEN_FILE=
# Raw agent token (alternative to JOURNAL_TOKEN_FILE).
JOURNAL_TOKEN=
# Return path (Matron -> bridge input): where the inbound cursor (highest
# journal seq consumed) is persisted, debounced, so a bridge restart resumes
# input from where it left off instead of reconnecting live-only forever. No
# file yet -> first connect is live-only (never replays history as input).
# Default: journal-cursor.json in the repo root.
JOURNAL_CURSOR_FILE=
# Unconfirmed session_state transitions, re-offered on reconnect so a frame
# evicted during an outage cannot leave a conversation stuck at "running"
# (which every client renders as a permanent "Thinking"). SINGLE WRITER: two
# bridges must never share this file, or each will retire the other's live
# conversations. Default: run-state-outbox.json in the bridge's own directory,
# which isolates a second checkout automatically.
MATRON_RUN_STATE_OUTBOX_FILE=
# Stable journal conversation id Matron sends session-management commands
# into (new/list/help — see README). Default: bridge-<hostname>.
JOURNAL_CONTROL_CONVO_ID=
